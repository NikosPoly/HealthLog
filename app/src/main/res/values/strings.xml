<resources>
    <!-- Default language: English. Greek is in values-el/strings.xml. -->
    <!-- The app name is the same in every language, so it is only defined here. -->
    <string name="app_name" translatable="false">HealthLog</string>

    <!-- Number and date formats of this language.
         format_locale: language used for words in dates (month names, AM/PM).
         date_time_pattern: see java.time.format.DateTimeFormatter.
         New languages: use the international date format "yyyy-MM-dd HH:mm"
         unless decided otherwise. -->
    <string name="format_locale">en</string>
    <string name="decimal_separator">.</string>
    <string name="date_time_pattern">MMM d, yyyy, h:mm a</string>

    <!-- Texts combined from parts. %1$s = label, %2$s = unit -->
    <string name="field_label_with_unit">%1$s (%2$s)</string>
    <!-- %1$s = measurement type, %2$s = value with unit -->
    <string name="delete_dialog_details">%1$s: %2$s</string>

    <!-- Home screen -->
    <string name="home_title">Health Log</string>
    <string name="home_new_measurement">New measurement</string>

    <!-- History screen -->
    <string name="history_title">Measurement history</string>
    <string name="history_empty">No entries yet.</string>

    <!-- History charts. %1$s = measurement type -->
    <string name="chart_show_trend">See trend</string>
    <string name="chart_show_history">See history</string>
    <string name="chart_period_7_days">7 days</string>
    <string name="chart_period_30_days">30 days</string>
    <string name="chart_period_6_months">6 months</string>
    <string name="chart_period_1_year">1 year</string>
    <string name="chart_period_all">All</string>
    <string name="chart_empty">The chart needs measurements from this period.</string>
    <string name="chart_description">Chart of %1$s</string>

    <!-- Chart stats -->
    <string name="stats_period_title">In this period</string>
    <string name="stats_count">Measurements</string>
    <string name="stats_highest">Highest</string>
    <string name="stats_lowest">Lowest</string>
    <string name="stats_average">Average</string>
    <string name="stats_highest_systolic">Highest systolic</string>
    <string name="stats_lowest_systolic">Lowest systolic</string>
    <string name="stats_highest_diastolic">Highest diastolic</string>
    <string name="stats_lowest_diastolic">Lowest diastolic</string>
    <string name="stats_last_recorded">Last recorded</string>
    <string name="stats_latest_measurement">Latest measurement</string>

    <!-- Buttons and actions used in several places -->
    <string name="action_back">Back</string>
    <string name="action_save">Save</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_delete">Delete</string>

    <!-- Entry dialog -->
    <string name="entry_timestamp_note">The date and time are saved automatically.</string>
    <string name="entry_required_note">* Required field</string>

    <!-- Validation errors in the entry dialog -->
    <string name="error_required">This field is required</string>
    <string name="error_incomplete_decimal">Add a decimal digit or remove the decimal point</string>
    <string name="error_invalid_number">Invalid value</string>
    <!-- %1$s = lowest accepted value, %2$s = highest accepted value -->
    <string name="error_value_out_of_range">The value must be between %1$s and %2$s</string>
    <string name="error_diastolic_not_below_systolic">Diastolic must be lower than systolic</string>

    <!-- Delete confirmation dialog -->
    <string name="delete_dialog_title">Delete measurement</string>
    <string name="delete_dialog_message">Are you sure you want to delete this measurement?</string>

    <!-- Snackbar messages -->
    <string name="message_measurement_saved">Measurement saved</string>
    <string name="message_measurement_deleted">Measurement deleted</string>

    <!-- Measurement types (single-value types also use these as their field label) -->
    <string name="type_blood_pressure">Blood Pressure</string>
    <string name="type_pulse">Pulse</string>
    <string name="type_blood_sugar">Blood Sugar</string>
    <string name="type_weight">Weight</string>
    <string name="type_height">Height</string>

    <!-- Blood pressure fields -->
    <string name="field_systolic">Systolic</string>
    <string name="field_diastolic">Diastolic</string>
</resources>
